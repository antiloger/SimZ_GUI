{
  "typeName": "Battery",
  "discription": "A component that stores electrical energy.",
  "color": "#4CAF50",
  "category": "model",
  "InputForm": [
    {
      "inputName": "capacity",
      "fieldType": "int",
      "defaultValue": 10000,
      "validation": "min:500|max:50000",
      "display": true,
      "discription": "The storage capacity of the battery in mAh.",
      "required": true
    },
    {
      "inputName": "chargingEfficiency",
      "fieldType": "float",
      "defaultValue": 0.9,
      "validation": "min:0.7|max:1",
      "display": true,
      "discription": "The efficiency of charging as a fraction.",
      "required": true
    }
  ],
  "OutputForm": [
    {
      "typeOut": "storedEnergy"
    },
    {
      "typeOut": "chargingStatus"
    }
  ]
}
